generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Infrastructure {
  id             String        @id                @default(uuid())
  userId         String                           @default("test-user")
  name           String
  layout         Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

